<%= form_with(model: basket, html: { novalidate: true }, 
      data: { 
        controller: "double-slider", 
        action: "submit->double-slider#validateForm", 
        double_slider_min_limit_value: 5, 
        double_slider_max_limit_value: 25, 
        double_slider_step_value: 0.5 
      }) do |form| %>

  <div>
    <p>
      <%= form.label :name, "Basket Name (e.g., Bottomless, Doublespout)", style: "display: block; font-weight: 700; margin-bottom: 6px;" %><br>
      <%= form.text_field :name, placeholder: Basket.next_default_name, style: "width: 100%; box-sizing: border-box;" %>
    </p>

    <!-- Dose Range Double Slider Card -->
    <div class="dose-range-card">
      <div class="dose-range-header">
        <span class="dose-range-title"><i class="fa-solid fa-scale-balanced" style="margin-right: 6px; color: var(--accent);"></i> Dose Capacity Range</span>
        <span class="dose-range-badge" data-double-slider-target="rangeBadge">
          <%= basket.min_dose || 16.0 %>g – <%= basket.max_dose || 18.0 %>g
        </span>
      </div>

      <div class="dose-range-inputs-row">
        <!-- Min Dose Input -->
        <div class="dose-input-box">
          <label class="dose-input-label">Min Dose</label>
          <div class="dose-input-pill">
            <%= form.number_field :min_dose, 
                  value: basket.min_dose || 16.0,
                  step: 0.5, 
                  min: 0.5, 
                  class: "dose-range-num-input", 
                  data: { 
                    double_slider_target: "minInput", 
                    action: "input->double-slider#onMinInputChange change->double-slider#onMinInputCommit blur->double-slider#onMinInputCommit" 
                  } %>
            <span class="dose-range-unit">g</span>
          </div>
        </div>

        <div class="dose-range-separator">
          <i class="fa-solid fa-arrow-right-long"></i>
        </div>

        <!-- Max Dose Input -->
        <div class="dose-input-box">
          <label class="dose-input-label">Max Dose</label>
          <div class="dose-input-pill">
            <%= form.number_field :max_dose, 
                  value: basket.max_dose || 18.0,
                  step: 0.5, 
                  min: 0.5, 
                  class: "dose-range-num-input", 
                  data: { 
                    double_slider_target: "maxInput", 
                    action: "input->double-slider#onMaxInputChange change->double-slider#onMaxInputCommit blur->double-slider#onMaxInputCommit" 
                  } %>
            <span class="dose-range-unit">g</span>
          </div>
        </div>
      </div>

      <!-- Slider Track -->
      <div class="double-slider-track-wrap" 
           data-double-slider-target="trackWrap" 
           data-action="pointerdown->double-slider#onTrackPointerDown pointermove->double-slider#onTrackPointerMove pointerup->double-slider#onTrackPointerUp pointercancel->double-slider#onTrackPointerUp">
        <div class="double-slider-rail"></div>
        <div class="double-slider-highlight" data-double-slider-target="highlight"></div>
        <input type="range" 
               min="5" max="25" step="0.5" 
               value="<%= [[5.0, (basket.min_dose || 16.0).to_f].max, 25.0].min %>"
               class="double-slider-range" 
               data-double-slider-target="minSlider" 
               data-action="input->double-slider#onMinSliderChange pointerdown->double-slider#bringToFront">
        <input type="range" 
               min="5" max="25" step="0.5" 
               value="<%= [[5.0, (basket.max_dose || 18.0).to_f].max, 25.0].min %>"
               class="double-slider-range" 
               data-double-slider-target="maxSlider" 
               data-action="input->double-slider#onMaxSliderChange pointerdown->double-slider#bringToFront">
      </div>

      <!-- Scale ticks / labels -->
      <div class="double-slider-scale">
        <span>5g</span>
        <span>10g</span>
        <span>15g</span>
        <span>20g</span>
        <span>25g</span>
      </div>
    </div>

    <br>
    
    <div style="display: flex; gap: 12px; align-items: center; margin-top: 10px;">
      <%= form.submit "Save Basket", data: { double_slider_target: "submitBtn" } %>
      <button type="button" 
              class="btn-return-subtle" 
              data-controller="return-discard"
              data-return-discard-return-url-value="<%= baskets_path %>"
              data-action="click->return-discard#handleClick">
        Return
      </button>
    </div>
  </div>
<% end %>
