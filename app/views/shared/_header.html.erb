<div class="page-header">
  <% if local_assigns[:show_back] && local_assigns[:back_path].present? %>
    <%= link_to local_assigns[:back_path], class: "back-btn" do %>
      <i class="fa-solid fa-arrow-left"></i> <%= local_assigns.fetch(:back_label, "Back") %>
    <% end %>
  <% end %>

  <%# Title and optional right action %>
  <div style="display: flex; justify-content: space-between; align-items: center; gap: 16px;">
    <h1 class="page-title"><%= title %></h1>

    <% if local_assigns[:action].present? %>
      <div style="display: flex; align-items: center; gap: 8px;">
        <%= action %>
      </div>
    <% end %>
  </div>

  <%# Optional subtitle, shown under the title row when passed in %>
  <% if local_assigns[:subtitle].present? %>
    <p class="page-subtitle"><%= subtitle %></p>
  <% end %>
</div>
