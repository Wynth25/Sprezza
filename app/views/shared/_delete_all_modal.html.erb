<!-- Backdrop / Modal Container -->
<div class="modal-backdrop hidden" 
     data-delete-modal-target="modal" 
     data-action="click->delete-modal#closeModal">
  
  <!-- Modal Card (Clicks inside do not close modal) -->
  <div class="modal-box" data-action="click->delete-modal#stopProp">
    
    <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 16px;">
      <div style="display: flex; align-items: center; gap: 10px; color: var(--danger-red, #dc2626);">
        <i class="fa-solid fa-triangle-exclamation" style="font-size: 1.5rem;"></i>
        <h2 style="margin: 0; font-size: 1.35rem; color: var(--header-brown);">Delete All Data</h2>
      </div>
      <button type="button" 
              data-action="click->delete-modal#closeModal" 
              style="background: transparent; border: none; font-size: 1.4rem; cursor: pointer; color: #888; padding: 4px;">
        &times;
      </button>
    </div>

    <p style="font-size: 0.95rem; color: var(--text-brown); line-height: 1.5; margin-bottom: 16px;">
      <% if admin_logged_in? %>
        <strong>Warning:</strong> This will <strong>permanently destroy all</strong> beans, baskets, recipes, and brew history in your private database. This action <em>cannot</em> be undone.
      <% else %>
        <strong>Warning:</strong> This will clear all mock beans, recipes, and brew adjustments from your sandbox session.
      <% end %>
    </p>

    <div style="background: rgba(233, 75, 89, 0.08); border: 1.5px dashed var(--danger-red, #dc2626); border-radius: 12px; padding: 12px 14px; margin-bottom: 18px;">
      <p style="margin: 0; font-size: 0.88rem; font-weight: 700; color: var(--text-brown);">
        To confirm, type <span style="background: white; padding: 2px 7px; border-radius: 6px; font-family: monospace; color: #c02636; border: 1px solid #ecccd0;">yes, delete everything</span> below:
      </p>
    </div>

    <%= form_with url: purge_data_path, method: :delete, data: { action: "submit->delete-modal#confirmDelete" } do |f| %>
      <div style="margin-bottom: 20px;">
        <%= f.text_field :confirmation, 
              placeholder: "yes, delete everything", 
              autocomplete: "off",
              spellcheck: "false",
              data: { delete_modal_target: "input", action: "input->delete-modal#validateInput" },
              style: "width: 100%; box-sizing: border-box; padding: 12px 14px; font-size: 1rem; border-radius: 10px; border: 2px solid var(--btn-bg);" %>
      </div>

      <div style="display: flex; justify-content: flex-end; gap: 10px;">
        <button type="button" 
                class="btn-secondary" 
                data-action="click->delete-modal#closeModal" 
                style="border-radius: 10px; padding: 10px 18px; font-weight: 700; cursor: pointer;">
          Cancel
        </button>
        
        <button type="submit" 
                data-delete-modal-target="submitBtn" 
                disabled 
                style="border-radius: 10px; padding: 10px 18px; font-weight: 700; background-color: #dc2626; color: white; border: none; transition: all 0.2s; opacity: 0.4; cursor: not-allowed;">
          <i class="fa-solid fa-trash-can"></i> Yes, Delete Everything
        </button>
      </div>
    <% end %>

  </div>
</div>
