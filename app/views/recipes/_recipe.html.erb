<div id="<%= dom_id recipe %>">
<div>
    <strong>Bean:</strong>
    <%= recipe.bean.roastery %> <%= recipe.bean.name %>
  </div>

  <% if recipe.pour_over? %>
    <div>
      <strong>Water:</strong>
      <%= recipe.water %>ml
    </div>
  <% else %>
    <div>
      <strong>Basket:</strong>
      <%= recipe.basket&.name %>
    </div>
  <% end %>

  <div>
    <strong>Style:</strong>
    <%= recipe.style %>
  </div>

</div>
