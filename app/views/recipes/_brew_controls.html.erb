<%= turbo_frame_tag "brew_controls_#{recipe.id}" do %>
  <% latest = recipe.latest_brew %>
  <% base_dose = latest&.dose || 18.0 %>
  <% base_grind = latest&.grind || 4.0 %>
  <% 
    d_step_1 = Setting.get("dose_step_1", "0.5").to_f
    d_step_2 = Setting.get("dose_step_2", "1.0").to_f
    d_step_1 = 0.5 if d_step_1 <= 0
    d_step_2 = 1.0 if d_step_2 <= 0

    g_step_1 = Setting.get("grind_step_1", "0.1").to_f
    g_step_2 = Setting.get("grind_step_2", "0.2").to_f
    g_step_1 = 0.1 if g_step_1 <= 0
    g_step_2 = 0.2 if g_step_2 <= 0

    fmt_num = ->(v) { v == v.to_i ? v.to_i.to_s : v.to_s }
  %>
  
  <div data-controller="brew-adjust" 
       data-brew-adjust-base-dose-value="<%= base_dose %>" 
       data-brew-adjust-base-grind-value="<%= base_grind %>"
       class="recipe-dial-container">
       
    <%= form_with url: quick_log_recipe_path(recipe), method: :post, data: { turbo_frame: "_top", recipe_id: recipe.id } do |f| %>
      
      <div class="dial-layout">
        
        <!-- Left Buttons Column -->
        <div class="dial-side-col dial-left-col">
          <div class="dial-btn-row">
            <button type="button" class="dial-step-btn" data-brew-adjust-target="doseBtn" data-action="brew-adjust#selectDose" data-amount="-<%= d_step_2 %>">-<%= fmt_num.call(d_step_2) %>g</button>
            <button type="button" class="dial-step-btn" data-brew-adjust-target="doseBtn" data-action="brew-adjust#selectDose" data-amount="-<%= d_step_1 %>">-<%= fmt_num.call(d_step_1) %>g</button>
          </div>
          <div class="dial-btn-row">
            <button type="button" class="dial-step-btn" data-brew-adjust-target="grindBtn" data-action="brew-adjust#selectGrind" data-amount="-<%= g_step_2 %>">-<%= fmt_num.call(g_step_2) %></button>
            <button type="button" class="dial-step-btn" data-brew-adjust-target="grindBtn" data-action="brew-adjust#selectGrind" data-amount="-<%= g_step_1 %>">-<%= fmt_num.call(g_step_1) %></button>
          </div>
        </div>

        <!-- Center Card -->
        <div class="dial-card recipe-card <%= 'recipe-card-pour-over' if recipe.pour_over? %>">
          <% if (badge = recipe.corner_badge) %>
            <div class="recipe-corner-badge"><%= badge %></div>
          <% end %>

          <div class="recipe-card-title dial-card-title">
            <% if recipe.pour_over? %>
              <div class="recipe-stat recipe-stat-water"><%= recipe.water %><small>ml</small></div>
            <% else %>
              <%= recipe.basket&.name %>
            <% end %>
          </div>

          <div class="recipe-card-stats dial-card-stats">
            <!-- Dose Row -->
            <div class="dial-stat-row">
              <button type="button" class="dial-reset-btn hidden" data-brew-adjust-target="doseResetBtn" data-action="brew-adjust#resetDose" title="Reset dose">
                <i class="fa-solid fa-rotate-left"></i>
              </button>
              <div class="dial-input-box">
                <%= f.number_field :dose, value: base_dose, step: 0.1, class: "dial-number-input", 
                      data: { brew_adjust_target: "doseInput", action: "input->brew-adjust#manualDose" } %>
              </div>
              <span class="dial-unit">g</span>
            </div>

            <!-- Grind Row -->
            <div class="dial-stat-row">
              <button type="button" class="dial-reset-btn hidden" data-brew-adjust-target="grindResetBtn" data-action="brew-adjust#resetGrind" title="Reset grind">
                <i class="fa-solid fa-rotate-left"></i>
              </button>
              <div class="dial-input-box">
                <%= f.number_field :grind, value: base_grind, step: 0.1, class: "dial-number-input", 
                      data: { brew_adjust_target: "grindInput", action: "input->brew-adjust#manualGrind" } %>
              </div>
              <span class="dial-unit"><i class="fa-solid fa-gear"></i></span>
            </div>
          </div>
        </div>

        <!-- Right Buttons Column -->
        <div class="dial-side-col dial-right-col">
          <div class="dial-btn-row">
            <button type="button" class="dial-step-btn" data-brew-adjust-target="doseBtn" data-action="brew-adjust#selectDose" data-amount="<%= d_step_1 %>">+<%= fmt_num.call(d_step_1) %>g</button>
            <button type="button" class="dial-step-btn" data-brew-adjust-target="doseBtn" data-action="brew-adjust#selectDose" data-amount="<%= d_step_2 %>">+<%= fmt_num.call(d_step_2) %>g</button>
          </div>
          <div class="dial-btn-row">
            <button type="button" class="dial-step-btn" data-brew-adjust-target="grindBtn" data-action="brew-adjust#selectGrind" data-amount="<%= g_step_1 %>">+<%= fmt_num.call(g_step_1) %></button>
            <button type="button" class="dial-step-btn" data-brew-adjust-target="grindBtn" data-action="brew-adjust#selectGrind" data-amount="<%= g_step_2 %>">+<%= fmt_num.call(g_step_2) %></button>
          </div>
        </div>

      </div>

      <div class="dial-actions-container">
        <div class="dial-actions-row">
          <div class="dial-action-slot dial-slot-left">
            <button type="button" 
                    class="dial-action-icon-btn dial-notes-btn" 
                    data-brew-adjust-target="notesBtn"
                    data-action="click->brew-adjust#toggleNotes" 
                    title="Add notes">
              <i class="fa-solid fa-pen-to-square"></i>
            </button>
          </div>

          <div class="dial-action-slot dial-slot-center">
            <%= f.submit "Log", class: "btn-primary dial-save-btn dial-brew-btn" %>
          </div>

          <div class="dial-action-slot dial-slot-right">
            <button type="button" 
                    class="btn-return-subtle dial-action-icon-btn dial-return-btn" 
                    data-controller="return-discard"
                    data-return-discard-return-url-value="<%= recipes_path %>"
                    data-return-discard-preserve-content-value="true"
                    data-action="click->return-discard#handleClick"
                    title="Return">
              <i class="fa-solid fa-arrow-left"></i>
            </button>
          </div>
        </div>

        <!-- Collapsible Notes Box Below -->
        <div class="dial-notes-box hidden" data-brew-adjust-target="notesBox">
          <textarea name="brew_notes" class="dial-notes-input" placeholder="Proposed ratios, additional changes..." rows="3"></textarea>
        </div>
      </div>
    <% end %>
  </div>
<% end %>
