<div data-controller="dashboard">
  
  <!-- Backdrop Overlay (Intercepts taps outside the menu) -->
  <div class="menu-backdrop hidden" data-dashboard-target="backdrop" data-action="click->dashboard#closeDropdown"></div>

  <!-- Capture Header Actions for the Universal Header -->
  <% header_actions = capture do %>
    <div data-dashboard-target="contextActions" class="context-actions hidden">
      <button type="button" data-action="dashboard#cancelMode" class="btn-secondary">Cancel</button>
      <button type="button" data-action="dashboard#doneMode" class="btn-primary">Done</button>
    </div>

    <div class="dropdown-container">
      <button type="button" data-dashboard-target="menuToggle" class="menu-toggle-btn" data-action="dashboard#toggleDropdown" title="Menu">
        <i class="fa-solid fa-ellipsis-vertical"></i>
      </button>
      
      <div class="dropdown-menu hidden" data-dashboard-target="dropdownMenu">
        <button type="button" class="dropdown-item" data-action="dashboard#enableSortMode">
          <i class="fa-solid fa-grip-vertical"></i> Change order
        </button>
        
        <button type="button" class="dropdown-item" data-action="dashboard#enableDeleteMode">
          <i class="fa-solid fa-trash-can"></i> Delete
        </button>
        
        <hr>

        <%= link_to "<i class='fa-solid fa-gear'></i> Settings".html_safe, settings_path, class: "dropdown-item" %>
      </div>
    </div>
  <% end %>

  <!-- Universal Header -->
  <%= render "shared/header", 
        title: "Sprezza", 
        subtitle: "The art of the effortless dial-in.",
        action: header_actions %>

  <!-- Sortable Bean List -->
  <div data-dashboard-target="beanList">
    <% if @beans.any? %>
      <% @beans.each do |bean| %>
        <div data-id="<%= bean.id %>" style="background: transparent;">
          
          <div class="bean-heading">
            <span class="drag-handle"><i class="fa-solid fa-grip"></i></span>

            <div class="bean-heading-text">
              <!-- Links to the beans page and scrolls to this specific bean -->
              <%= link_to "#{bean.roastery} #{bean.name}", beans_path(anchor: "bean_#{bean.id}"), class: "bean-heading-name" %>
              <span class="bean-heading-age"><%= bean.effective_age_in_days %> days old</span>
            </div>

            <%= link_to "<i class='fa-solid fa-plus'></i>".html_safe, new_recipe_path(bean_id: bean.id), class: "action-icon-btn add-recipe-link", title: "Add recipe" %>
          </div>

          <% if bean.recipes.any? %>
            <div class="recipe-grid" data-dashboard-target="recipeGrid" data-bean-id="<%= bean.id %>" data-basket-scope="true">
              <% bean.recipes.each do |recipe| %>
                
                <div class="recipe-card-wrapper" data-id="<%= recipe.id %>" data-basket-id="<%= recipe.basket_id %>">
                  
                  <%= link_to recipe_path(recipe), class: "recipe-card" do %>
                    <% if recipe.style.to_s.start_with?("Ristretto") %>
                      <div class="recipe-corner-badge">R</div>
                    <% elsif recipe.style.to_s.start_with?("Lungo") %>
                      <div class="recipe-corner-badge">L</div>
                    <% end %>

                    <div class="recipe-card-title">
                      <%= recipe.basket.name %>
                    </div>
                    
                    <div class="recipe-card-stats">
                      <% if recipe.latest_brew %>
                        <div class="recipe-stat recipe-stat-dose"><%= recipe.latest_brew.dose %><small>g</small></div>
                        <div class="recipe-stat recipe-stat-grind"><%= recipe.latest_brew.grind %><i class="fa-solid fa-gear"></i></div>
                      <% else %>
                        <em style="font-size: 0.85rem; font-weight: 400; color: #888;">No brews</em>
                      <% end %>
                    </div>
                  <% end %>

                  <!-- Sort Overlay Grip (Sort mode) -->
                  <div class="recipe-sort-overlay">
                    <i class="fa-solid fa-grip-vertical"></i>
                  </div>

                  <!-- Delete Overlay Form (Delete mode) -->
                  <%= button_to recipe_path(recipe), method: :delete, form_class: "delete-overlay-form", data: { turbo_confirm: "Delete #{recipe.basket.name} recipe for #{bean.name}?" }, class: "recipe-delete-overlay" do %>
                    <i class="fa-solid fa-trash-can"></i>
                  <% end %>
                  
                </div>

              <% end %>
            </div>
          <% else %>
            <p>No baskets dialed in yet.</p>
          <% end %>
          
          <hr>
        </div>
      <% end %>
    <% else %>
      <div style="text-align: center; padding: 40px 20px; background-color: var(--card-cream); border: 2px dashed var(--btn-bg); border-radius: 16px;">
        <p style="font-weight: 700; color: var(--text-brown); margin-bottom: 12px;">No active beans or recipes yet.</p>
        <%= link_to "+ Add your first bean", new_bean_path %>
      </div>
    <% end %>
  </div>

</div>
