<div>
  <%= render "shared/header", title: "Recipe Details" %>

  <div>
    <h1><%= @recipe.bean.roastery %> <%= @recipe.bean.name %></h1>
    <p style="overflow-wrap: anywhere; word-break: break-word;">
      <%= @recipe.bean.description %></p>
    <p style="overflow-wrap: anywhere; word-break: break-word;">
      <%= @recipe.bean.notes %></p>
    
    <div id="recipe-latest-stat" style="display: none;">
      <% if @recipe.latest_brew %>
        <span class="stat-dose"><%= @recipe.latest_brew.dose %></span>g, <span class="stat-grind"><%= @recipe.latest_brew.grind %></span>
      <% else %>
        <span class="stat-dose">18.0</span>g, <span class="stat-grind">4.0</span>
      <% end %>
    </div>
  </div>

  <br>

  <%= render partial: "recipes/brew_controls", locals: { recipe: @recipe } %>

  <br>
  <hr>

  <div>
    <h3 style="font-size: 1.25rem; font-weight: 800; color: var(--header-brown); margin: 24px 0 12px 0;">Brew History</h3>
    <div id="brew-history-list" class="brew-history-list">
      <% if @recipe.brews.any? %>
        <% brews_list = @recipe.brews.order(created_at: :desc).to_a %>
        <% brews_list.each_with_index do |brew, index| %>
          <% 
            is_latest = (index == 0)
            is_current_year = brew.created_at.year == Time.current.year
            date_formatted = is_current_year ? brew.created_at.strftime("%-d.%-m %H:%M") : brew.created_at.strftime("%-d.%-m.%Y %H:%M")
            days_ago = (Date.current - brew.created_at.to_date).to_i
            is_starred = brew.respond_to?(:star) && brew.star?
            brew_notes = brew.respond_to?(:notes) ? brew.notes.presence : nil
            starred_date = (brew.respond_to?(:starred_at) && brew.starred_at.present?) ? brew.starred_at.to_date : brew.updated_at&.to_date
            
            bean_age_at_star = if is_starred && @recipe.bean&.roast_date.present?
              @recipe.bean.effective_age_in_days(as_of: (starred_date || brew.created_at.to_date))
            end

            age_formatted = if is_starred
              star_days = (Date.current - (starred_date || brew.created_at.to_date)).to_i
              label = if star_days <= 0
                "Starred today"
              elsif star_days == 1
                "Starred 1 day ago"
              else
                "Starred #{star_days} days ago"
              end
              bean_age_at_star ? "#{label} (#{bean_age_at_star}d bean)" : label
            else
              if days_ago <= 0
                "Today"
              elsif days_ago == 1
                "1 day since"
              else
                "#{days_ago} days since"
              end
            end
          %>
          <%
            raw_starred_at = brew.respond_to?(:starred_at) && brew.starred_at.present? ? brew.starred_at : brew.created_at
            starred_at_val = raw_starred_at ? raw_starred_at.strftime("%Y-%m-%dT%H:%M") : ""
          %>
          <div class="history-card <%= 'starred' if is_starred %>" 
               data-brew-id="<%= brew.id %>"
               data-controller="brew-history-edit"
               data-brew-history-edit-url-value="/recipes/<%= @recipe.id %>/brews/<%= brew.id %>"
               data-brew-history-edit-brew-id-value="<%= brew.id %>"
               data-brew-history-edit-dose-value="<%= brew.dose %>"
               data-brew-history-edit-grind-value="<%= brew.grind %>"
               data-brew-history-edit-created-at-value="<%= brew.created_at.strftime("%Y-%m-%dT%H:%M") %>"
               data-brew-history-edit-is-starred-value="<%= is_starred %>"
               data-brew-history-edit-starred-at-value="<%= starred_at_val %>"
               data-brew-history-edit-roast-date-value="<%= @recipe.bean&.roast_date&.strftime("%Y-%m-%d") %>"
               data-brew-history-edit-is-latest-value="<%= is_latest %>">
            <div class="history-card-main">
              <!-- Regular View Stats -->
              <div class="history-card-stats" data-brew-history-edit-target="viewStats">
                <div class="recipe-stat recipe-stat-dose" data-brew-history-edit-target="doseDisplay"><%= brew.dose %><small>g</small></div>
                <div class="recipe-stat recipe-stat-grind" data-brew-history-edit-target="grindDisplay"><%= brew.grind %><i class="fa-solid fa-gear"></i></div>
              </div>

              <!-- Edit View Stats with Arrow Controls (Number textboxes with up/down arrows) -->
              <div class="history-card-stats hidden" data-brew-history-edit-target="editStats">
                <div class="history-edit-row">
                  <input type="number" 
                         step="0.1" 
                         min="0.1" 
                         class="history-number-input"
                         style="width: 72px !important; max-width: 72px !important;"
                         data-brew-history-edit-target="doseInput"
                         data-action="input->brew-history-edit#onDoseInput"
                         value="<%= brew.dose %>">
                  <span class="history-edit-unit">g</span>
                </div>

                <div class="history-edit-row">
                  <input type="number" 
                         step="0.1" 
                         min="0.1" 
                         class="history-number-input"
                         style="width: 72px !important; max-width: 72px !important;"
                         data-brew-history-edit-target="grindInput"
                         data-action="input->brew-history-edit#onGrindInput"
                         value="<%= brew.grind %>">
                  <span class="history-edit-unit"><i class="fa-solid fa-gear"></i></span>
                </div>
              </div>

              <div class="history-card-divider-v"></div>

              <div class="history-card-info">
                <!-- Regular View Date & Age -->
                <div data-brew-history-edit-target="viewInfo">
                  <div class="history-card-date" data-brew-history-edit-target="dateDisplay"><%= date_formatted %></div>
                  <div class="history-card-age" data-created-at="<%= brew.created_at.iso8601 %>" data-bean-age="<%= @recipe.bean&.effective_age_in_days %>"><%= age_formatted %></div>
                </div>

                <!-- Edit View Date & Time Picker -->
                <div class="hidden" data-brew-history-edit-target="editInfo">
                  <input type="datetime-local" 
                         class="history-datetime-input"
                         data-brew-history-edit-target="datetimeInput"
                         data-action="input->brew-history-edit#onDatetimeInput"
                         value="<%= brew.created_at.strftime("%Y-%m-%dT%H:%M") %>">

                  <% if is_starred %>
                    <div style="margin-top: 6px;">
                      <button type="button" 
                              class="history-star-date-toggle-btn" 
                              data-brew-history-edit-target="starDateToggleBtn"
                              data-action="click->brew-history-edit#toggleStarDatePopup"
                              title="Edit starred date">
                        <i class="fa-solid fa-star" style="color: #d97706;"></i>
                        <span>Starred Date</span>
                      </button>

                      <div class="history-star-date-popup hidden" data-brew-history-edit-target="starDatePopup">
                        <input type="datetime-local" 
                               class="history-datetime-input"
                               data-brew-history-edit-target="starDatetimeInput"
                               data-action="input->brew-history-edit#onStarDatetimeInput"
                               value="<%= starred_at_val %>">
                      </div>
                    </div>
                  <% end %>
                </div>
              </div>

              <div class="history-card-actions">
                <!-- Standard Mode Buttons -->
                <button type="button" 
                        class="action-icon-btn history-action-btn" 
                        title="Edit Brew"
                        data-brew-history-edit-target="editBtn"
                        data-action="click->brew-history-edit#startEdit">
                  <i class="fa-solid fa-pencil"></i>
                </button>
                <button type="button" 
                        class="action-icon-btn history-action-btn <%= 'starred' if is_starred %>" 
                        title="<%= is_starred ? 'Starred' : 'Star Brew' %>"
                        data-brew-history-edit-target="starBtn"
                        data-controller="brew-star"
                        data-brew-star-url-value="/recipes/<%= @recipe.id %>/brews/<%= brew.id %>"
                        data-brew-star-starred-value="<%= is_starred ? 'true' : 'false' %>"
                        data-brew-star-brew-id-value="<%= brew.id %>"
                        data-action="click->brew-star#toggle">
                  <i class="<%= is_starred ? 'fa-solid fa-star' : 'fa-regular fa-star' %>"></i>
                </button>

                <!-- Edit Mode Buttons: Save (Checkmark) & Discard (X-mark) -->
                <button type="button" 
                        class="action-icon-btn history-action-btn btn-save-brew hidden" 
                        title="Save Changes"
                        data-brew-history-edit-target="saveBtn"
                        data-action="click->brew-history-edit#save">
                  <i class="fa-solid fa-check"></i>
                </button>
                <button type="button" 
                        class="action-icon-btn history-action-btn btn-discard-brew hidden" 
                        title="Discard Changes"
                        data-brew-history-edit-target="discardBtn"
                        data-action="click->brew-history-edit#discard">
                  <i class="fa-solid fa-xmark"></i>
                </button>
              </div>
            </div>

            <% if brew_notes.present? %>
              <div class="history-card-divider-h"></div>
              <div class="history-card-notes">
                <%= brew_notes %>
              </div>
            <% end %>
          </div>
        <% end %>
      <% else %>
        <div class="empty-history"><p style="color: #888; font-style: italic;">No adjustments saved yet.</p></div>
      <% end %>
    </div>
  </div>
</div>
