<%= form_with(model: bean) do |form| %>
  <% if bean.errors.any? %>
    <div>
      <h2><%= pluralize(bean.errors.count, "error") %> prohibited this bean from being saved:</h2>
      <ul>
        <% bean.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <p>
      <%= form.label :roastery, "Roastery" %><br>
      <%= form.text_field :roastery, placeholder: "Doubleshot Coffee" %>
    </p>

    <p>
      <%= form.label :name, "Bean Name" %><br>
      <%= form.text_field :name, placeholder: "Era" %>
    </p>

    <p>
      <%= form.label :description, "Description" %><br>
      <%= form.text_area :description, rows: 4, placeholder: "Bolivia | Palli Family, Caturra, Washed" %>
    </p>

    <p>
      <%= form.label :notes, "Notes" %><br>
      <%= form.text_area :notes, rows: 4, placeholder: "Stone fruit, Almonds and Molasses" %>
    </p>

    <p>
      <%= form.label :roast_date, "Roast Date" %><br>
      <%= form.date_field :roast_date %>
    </p>

    <br>

    <div style="display: flex; gap: 12px; align-items: center;">
      <%= form.submit "Save Bean" %>
      <button type="button" 
              class="btn-return-subtle" 
              data-controller="return-discard"
              data-return-discard-return-url-value="<%= beans_path %>"
              data-action="click->return-discard#handleClick">
        Return
      </button>
    </div>
  </div>
<% end %>