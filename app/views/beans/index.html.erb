<% content_for :title, "Beans" %>

<div data-controller="dashboard">
  
  <!-- Global Backdrop Overlay -->
  <div class="menu-backdrop hidden" data-dashboard-target="backdrop" data-action="click->dashboard#closeDropdown"></div>

  <!-- Universal Header Actions -->
  <% header_actions = capture do %>
    <div data-dashboard-target="contextActions" class="context-actions hidden">
      <button type="button" data-action="click->dashboard#cancelMode" class="btn-secondary">Cancel</button>
      <button type="button" data-action="click->dashboard#doneMode" class="btn-primary">Done</button>
    </div>

    <div class="header-normal-actions" style="display: flex; gap: 8px; align-items: center;">
      <%= link_to "<i class='fa-solid fa-plus'></i>".html_safe, new_bean_path, class: "action-icon-btn", style: "background-color: var(--header-brown); color: white;", title: "New Bean" %>

      <!-- Toggle between Active and Archived lists -->
      <% if params[:archived] == 'true' %>
        <%= link_to "Active", beans_path, class: "btn-secondary", style: "border-radius: 20px; padding: 6px 14px; font-weight: 700; text-decoration: none;" %>
      <% else %>
        <%= link_to "Archived", beans_path(archived: true), class: "btn-secondary", style: "border-radius: 20px; padding: 6px 14px; font-weight: 700; text-decoration: none;" %>
      <% end %>
    </div>

    <div class="dropdown-container">
      <button type="button" data-dashboard-target="menuToggle" class="menu-toggle-btn" data-action="dashboard#toggleDropdown" title="Menu">
        <i class="fa-solid fa-ellipsis-vertical"></i>
      </button>

      <div class="dropdown-menu hidden" data-dashboard-target="dropdownMenu">
        <button type="button" class="dropdown-item" data-action="dashboard#enableSortMode">
          <i class="fa-solid fa-grip-vertical"></i> Change order
        </button>

        <hr>

        <%= link_to "<i class='fa-solid fa-gear'></i> Settings".html_safe, settings_path, class: "dropdown-item" %>
      </div>
    </div>
  <% end %>

  <%= render "shared/header", 
        title: "Beans", 
        action: header_actions %>

  <!-- Bean List -->
  <div data-dashboard-target="beanList" id="beans" style="display: flex; flex-direction: column; gap: 16px;">
    <% @beans.each do |bean| %>
      <%= render "beans/bean_card", bean: bean, show_actions: true %>
    <% end %>
    
    <% if @beans.empty? %>
      <div style="text-align: center; padding: 40px 20px; background-color: var(--card-cream); border: 2px dashed var(--btn-bg); border-radius: 16px;">
        <p style="font-weight: 700; color: var(--text-brown); margin-bottom: 12px;">No beans here.</p>
        <% unless params[:archived] == 'true' %>
          <%= link_to "+ Add your first bean", new_bean_path %>
        <% end %>
      </div>
    <% end %>
  </div>

</div>
