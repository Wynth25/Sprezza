<% content_for :title, "Edit Bean" %>

<%= render "shared/header", title: "Edit Bean" %>

<%= render "form", bean: @bean %>

<div data-controller="bean-delete">
  <hr style="margin: 32px 0; border: none; height: 2px; background-color: var(--btn-bg);">

  <div style="text-align: center;">
    <button type="button" 
            data-action="click->bean-delete#openModal" 
            class="btn-primary" 
            style="background-color: var(--danger-red); border-color: var(--danger-red); border-radius: 12px; padding: 10px 20px; font-weight: 700; cursor: pointer; display: inline-flex; align-items: center; gap: 8px;">
      <i class="fa-solid fa-trash-can"></i> Delete Bean
    </button>
  </div>

  <%= render "beans/delete_bean_modal", bean: @bean %>
</div>