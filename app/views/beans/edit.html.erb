<% content_for :title, "Edit Bean" %>

<%= render "shared/header", title: "Edit Bean" %>

<%= render "form", bean: @bean %>

<hr style="margin: 32px 0; border: none; height: 2px; background-color: var(--btn-bg);">

<div style="text-align: center;">
  <%= button_to "Delete Bean", bean_path(@bean), method: :delete, data: { turbo_confirm: "Are you sure you want to permanently delete this bean? All associated recipes will be lost." }, class: "btn-primary", style: "background-color: var(--danger-red); border-color: var(--danger-red);" %>
</div>