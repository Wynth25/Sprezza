<!-- Backdrop / Modal Container -->
<div class="modal-backdrop hidden" 
     data-bean-delete-target="modal" 
     data-action="click->bean-delete#closeModal">
  
  <!-- Modal Box -->
  <div class="modal-box" data-action="click->bean-delete#stopProp">
    
    <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 16px;">
      <div style="display: flex; align-items: center; gap: 10px; color: var(--danger-red, #dc2626);">
        <i class="fa-solid fa-triangle-exclamation" style="font-size: 1.5rem;"></i>
        <h2 style="margin: 0; font-size: 1.35rem; color: var(--header-brown);">Delete Bean</h2>
      </div>
      <button type="button" 
              data-action="click->bean-delete#closeModal" 
              style="background: transparent; border: none; font-size: 1.4rem; cursor: pointer; color: #888; padding: 4px;">
        &times;
      </button>
    </div>

    <!-- Archive Suggestion Callout -->
    <div style="background-color: var(--bg-beige, #fbf8f3); border: 1.5px solid var(--btn-bg, #eaddcf); border-radius: 12px; padding: 14px; margin-bottom: 16px;">
      <div style="display: flex; gap: 10px; align-items: flex-start;">
        <i class="fa-solid fa-box-archive" style="color: var(--accent); font-size: 1.2rem; margin-top: 2px;"></i>
        <div>
          <strong style="color: var(--header-brown); font-size: 0.95rem; display: block; margin-bottom: 4px;">Consider archiving instead</strong>
          <p style="margin: 0; font-size: 0.88rem; color: var(--text-brown); line-height: 1.45;">
            Archiving hides the bean from your active dashboard while preserving all dial-in history and recipes. If you ever buy <strong><%= bean.name %></strong> again, you can easily unarchive it with all settings ready!
          </p>
          <div style="margin-top: 10px;">
            <%= button_to bean_path(bean), params: { bean: { archived: true } }, method: :patch, class: "btn-secondary", style: "border-radius: 8px; padding: 6px 14px; font-size: 0.85rem; font-weight: 700; display: inline-flex; align-items: center; gap: 6px;" do %>
              <i class="fa-solid fa-box-archive"></i> Archive Bean Instead
            <% end %>
          </div>
        </div>
      </div>
    </div>

    <p style="font-size: 0.92rem; color: var(--text-brown); line-height: 1.5; margin-bottom: 16px;">
      <strong>Permanent Deletion:</strong> If you delete this bean, it and all associated recipes and brews will be permanently removed.
    </p>

    <div style="background: rgba(233, 75, 89, 0.08); border: 1.5px dashed var(--danger-red, #dc2626); border-radius: 12px; padding: 12px 14px; margin-bottom: 16px;">
      <p style="margin: 0; font-size: 0.88rem; font-weight: 700; color: var(--text-brown);">
        To permanently delete, type <span style="background: white; padding: 2px 7px; border-radius: 6px; font-family: monospace; color: #c02636; border: 1px solid #ecccd0;">delete</span> below:
      </p>
    </div>

    <%= form_with url: bean_path(bean), method: :delete, data: { action: "submit->bean-delete#confirmDelete" } do |f| %>
      <div style="margin-bottom: 20px;">
        <%= f.text_field :confirmation, 
              placeholder: "delete", 
              autocomplete: "off",
              spellcheck: "false",
              data: { bean_delete_target: "input", action: "input->bean-delete#validateInput" },
              style: "width: 100%; box-sizing: border-box; padding: 12px 14px; font-size: 1rem; border-radius: 10px; border: 2px solid var(--btn-bg);" %>
      </div>

      <div style="display: flex; justify-content: flex-end; gap: 10px;">
        <button type="button" 
                class="btn-secondary" 
                data-action="click->bean-delete#closeModal" 
                style="border-radius: 10px; padding: 10px 18px; font-weight: 700; cursor: pointer;">
          Cancel
        </button>
        
        <button type="submit" 
                data-bean-delete-target="submitBtn" 
                disabled 
                style="border-radius: 10px; padding: 10px 18px; font-weight: 700; background-color: #dc2626; color: white; border: none; transition: all 0.2s; opacity: 0.4; cursor: not-allowed;">
          <i class="fa-solid fa-trash-can"></i> Delete Bean
        </button>
      </div>
    <% end %>

  </div>
</div>
